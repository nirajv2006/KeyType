# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/keytype_db

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated or single)
FRONTEND_URL=http://localhost:5173

# JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=your_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
